+  a3=velocity+.5*h*b2;b3=-math.sin(position+.5*h*a2)
+  a4=velocity+h*b3;b4=-math.sin(position+h*a3)
+  position+=(h/6.)*(a1+2*a2+2*a3+a4);velocity+=(h/6.)*(b1+2*b2+2*b3+b4)
+ return position,velocity,steps
